# Local sync state and diagnostics
/state/
/logs/
/outbox/*
!/outbox/.gitkeep
!/outbox/apps/
/outbox/apps/*
!/outbox/apps/re-sleeving/
/outbox/apps/re-sleeving/*
!/outbox/apps/re-sleeving/build.json
# Credentials and local machine configuration
*.token
credentials*
local.ini
# Build outputs
/build/
/dist/
*.exe
*.dll
*.obj
*.pdb

# Python bytecode cache
__pycache__/
*.py[cod]
