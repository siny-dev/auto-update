{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siny-dev.github.io/auto-update/package-manifest-v1.schema.json",
  "title": "AutoUpdate package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract", "app_id", "version", "mode", "platform", "architecture", "minimum_engine", "publisher_policy", "files"],
  "properties": {
    "schema": {"const": 1},
    "contract": {"const": "autoupdate-app-v1"},
    "app_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "mode": {"enum": ["live", "restart"]},
    "platform": {"const": "windows"},
    "architecture": {"enum": ["any", "x86", "x64", "arm64"]},
    "minimum_engine": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "publisher_policy": {"const": "github-release-asset-https"},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "kind", "size", "sha256", "source", "asset"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"enum": ["data", "resource", "executable", "runtime"]},
          "size": {"type": "integer", "minimum": 0, "maximum": 268435456},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "source": {"type": "string", "minLength": 1},
          "asset": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
