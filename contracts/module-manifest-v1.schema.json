{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoupdate-module-v1.schema.json",
  "title": "AutoUpdate module package manifest v1",
  "type": "object",
  "required": ["schema", "contract", "module_id", "version", "api_major", "minimum_engine", "publisher_policy", "activation_mode", "files"],
  "properties": {
    "schema": { "const": 1 },
    "contract": { "const": "autoupdate-module-v1" },
    "module_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "api_major": { "type": "integer", "minimum": 1 },
    "minimum_engine": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "publisher_policy": { "const": "local-share-v1" },
    "activation_mode": { "enum": ["live", "restart"] },
    "reload_contract": { "enum": ["stateless-v1", "reload-hook-v1"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind", "size", "sha256", "source"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["data", "resource", "executable", "runtime"] },
          "size": { "type": "integer", "minimum": 0, "maximum": 268435456 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "source": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
